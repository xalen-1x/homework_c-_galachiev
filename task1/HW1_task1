#include <iostream>

char* find_end_int(char* num) {
    while(*num != '.' && *num != '\0') {
        num++;
    }
    return num;
}

void compare(char* num1, char* num2, bool is_neg) {
    while (*num1 == *num2 && *num1 != '\0' && *num2 != '\0') {
        num1++;
        num2++;
    }

    if (*num1 == '.') num1++;
    if (*num2 == '.') num2++;

    while (*num1 == *num2 && *num1 != '\0' && *num2 != '\0') {
        num1++;
        num2++;
    }

    if (*num1 > *num2) {
        std::cout << (is_neg ? "less" : "greater") << std::endl;
    } else if (*num2 > *num1) {
        std::cout << (is_neg ? "greater" : "less") << std::endl;
    } else {
        std::cout << "equal" << std::endl;
    }
}

int main(int argc, char* argv[]) {
    
    if (argc != 3) {
        return 1;
    }

    char* num1 = argv[1];
    char* num2 = argv[2];

    bool is_1neg = false, is_2neg = false;
    if (num1[0] == '-') {
        is_1neg = true;
        num1++;
    } else if (num1[0] == '+') num1++;
    if (num2[0] == '-') {
        is_2neg = true;
        num2++;
    } else if (num2[0] == '+') num2++;

    if (is_1neg > is_2neg) { 
        std::cout << "less" << std::endl;; 
        return 0;
    } else if (is_2neg > is_1neg) {
        std::cout << "greater" << std::endl;
        return 0;
    } else {
        char* end1 = find_end_int(num1);
        char* end2 = find_end_int(num2);

        if (end1-num1 > end2-num2) {
            std::cout << (is_1neg ? "less" : "greater") << std::endl;
            return 0;
        } else if (end1-num1 < end2-num2) {
            std::cout << (is_1neg ? "greater" : "less") << std::endl;
            return 0;
        } else {
            compare(num1, num2, is_1neg);   
        }
    }
    return 0;
}
